# Caddy fetches and renews a Let's Encrypt certificate automatically once the
# domain's A/AAAA record points at this server. No certbot, no cron.

{
	email {$ACME_EMAIL}
}

{$DOMAIN}, www.{$DOMAIN} {
	encode zstd gzip

	# Uploaded badge/award artwork is immutable (randomised filenames).
	@uploads path /uploads/*
	header @uploads Cache-Control "public, max-age=604800, immutable"

	# Hashed build assets.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy app:8080

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
